{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "group/media"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "hyprland/submap", "group/volume", "battery", "bluetooth", "network", "group/cpu", "memory"],
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "hyprland/window": {
        "max-length": 50
    },
    "hyprland/workspaces": {
      "on-click": "activate",
      "persistent-workspaces":{
        "*": 5,
        // "HDMI-A-1": 3
      }
    },
    "battery": {
        "interval": 60,
        "format": "{capacity}% {icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
    },
    "bluetooth": {
      "format": "",
      "format-disabled": "", // an empty format will hide the module
      "format-connected": " {num_connections}",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "exec kitty --title=bluetui -e bluetui"
    },
    "group/cpu": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "temperature"
        ]
    },
    "cpu": {
        "interval": 10,
        "format": " {}% |",
        "on-click": "exec kitty --title=btop -e btop"
    },
    "temperature": {
        "interval": 10,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": " {temperatureC}°C",
        "on-click": "exec kitty --title=btop -e btop"
    },
    "memory": {
        "interval": 30,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G/{total:0.1f}G used",
        "on-click": "exec kitty --title=htop -e htop",
    },
    "network": {
        "format": "",
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "󰤭", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "󰖪",
        "max-length": 50,
        "on-click": "exec nmrs",
    },
    "clock": {
      "format": "󰥔 {:%a, %d. %b %I:%M %p}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "format": {
          "today": "<span color='#75f1fa'><b>{}</b></span>"
        }
      },
      "on-click": "exec zen-browser https://calendar.google.com"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "pavucontrol",
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "group/volume": {
      "orientation": "horizontal",
      "modules": [
        "pulseaudio",
        "pulseaudio/slider"
      ]
    },
    "group/media": {
      "orientation": "horizontal",
      "modules": [
        "custom/media-prev",
        "custom/media-play-pause",
        "custom/media-next",
        "custom/media-switch",
        "custom/media-text"
      ]
    },
    "custom/media-prev": {
      "format": "",
      "on-click": "playerctl --player=playerctld --ignore-player=kdeconnect previous",
      "tooltip": false
    },
    "custom/media-play-pause": {
      "format": "{}",
      "exec": "playerctl --player=playerctld --ignore-player=kdeconnect --follow status 2>/dev/null | while read -r status; do [ \"$status\" = 'Playing' ] && echo '' || echo ''; done",
      "on-click": "playerctl --player=playerctld --ignore-player=kdeconnect play-pause",
      "tooltip": false
    },
    "custom/media-next": {
      "format": "",
      "on-click": "playerctl --player=playerctld --ignore-player=kdeconnect next",
      "tooltip": false
    },
    "custom/media-switch": {
      "format": "",
      "on-click": "playerctld shift",
      "on-click-right": "playerctld unshift",
      "tooltip": false
    },
    "custom/media-text": {
      "exec": "~/.config/waybar/custom_modules/media/media-scroll.sh",
      "escape": true,
      "tooltip": false,
      "on-click": "playerctl --player=playerctld --ignore-player=kdeconnect play-pause",
      "on-click-right": "playerctld shift",
      "on-click-middle": "playerctld unshift",
      "on-scroll-up": "playerctl --player=playerctld --ignore-player=kdeconnect position 5+",
      "on-scroll-down": "playerctl --player=playerctld --ignore-player=kdeconnect position 5-"
    }
}
